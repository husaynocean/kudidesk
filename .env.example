# PayPal SANDBOX credentials — developer.paypal.com → Apps & Credentials → Sandbox tab
# Leave both empty to run KudiDesk in demo mode with sample data.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Webhook ID from your sandbox app's Webhooks section (used to verify PayPal's signature).
PAYPAL_WEBHOOK_ID=

# Approximate naira value of 1 unit of each currency (used for the ≈ NGN column).
# Update these to today's rates.
FX_RATES_NGN={"USD":1500,"GBP":2000,"EUR":1700,"CAD":1100}

# Google Gemini — free key from https://aistudio.google.com/apikey
# Leave empty and KudiDesk's AI features fall back to a simple offline parser.
GEMINI_API_KEY=
# Optional: pin a model. Defaults to Google's current Flash model.
GEMINI_MODEL=gemini-flash-latest
# Optional: how long to wait for Gemini (ms).
GEMINI_TIMEOUT_MS=45000

# Optional: the name AI reminders are signed with, e.g. "Husayn — KudiDesk Studio".
FREELANCER_NAME=
